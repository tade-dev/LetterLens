{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/firebase/firebase-ios-sdk",
      "version": {
        "up-to-next-major-version": "12.13.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "LetterLens-iOS",
      "opaque-folders": [
        "Fonts",
      ],
      "target-membership": [
        "LetterLens-iOS",
      ],
      "membership-exceptions": [
        {
          "target": "LetterLens-iOS",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "LetterLens-iOS", "LetterLensShare" ] },
    { "kind": "folder", "path": "LetterLens-iOSTests", "target-membership": [ "LetterLens-iOSTests" ] },
    {
      "kind": "folder",
      "path": "LetterLensShare",
      "target-membership": [
        "LetterLensShare",
      ],
      "membership-exceptions": [
        {
          "target": "LetterLensShare",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/LetterLens-iOS.app", "id": "1E2712F730A5A7F1009D40AE", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/LetterLens-iOSTests.xctest", "id": "C4E8B1A07D2F49A6B3C5D7E1", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/LetterLensShare.appex", "id": "D1A2B3C4E5F60718293A4B5C", "type": "wrapper.app-extension", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "LetterLens-iOS",
      "id": "1E2712F630A5A7F1009D40AE",
      "product": "Products/LetterLens-iOS.app",
      "product-type": "application",
      "dependencies": [
        "LetterLensShare",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Check GoogleService-Info.plist",
          "input-paths": [
            "$(SRCROOT)/LetterLens-iOS/GoogleService-Info.plist",
            "$(SRCROOT)/LetterLens-iOS",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "plist=\"${SRCROOT}/LetterLens-iOS/GoogleService-Info.plist\"",
            "if [ ! -f \"${plist}\" ]; then",
            "  echo \"warning: GoogleService-Info.plist is missing, so Firebase is not configured and no cloud read will work. Put it in LetterLens-iOS/ (it is gitignored); see README. On-device reading still works.\"",
            "fi",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Embed LetterLensShare",
          "input-paths": [
            "$(BUILT_PRODUCTS_DIR)/LetterLensShare.appex",
          ],
          "output-paths": [
            "$(BUILT_PRODUCTS_DIR)/$(PLUGINS_FOLDER_PATH)/LetterLensShare.appex",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -e",
            "src=\"${BUILT_PRODUCTS_DIR}/LetterLensShare.appex\"",
            "dst=\"${BUILT_PRODUCTS_DIR}/${PLUGINS_FOLDER_PATH}\"",
            "if [ ! -d \"${src}\" ]; then",
            "  echo \"error: LetterLensShare.appex was not built. The share sheet entry needs it.\"",
            "  exit 1",
            "fi",
            "mkdir -p \"${dst}\"",
            "rm -rf \"${dst}/LetterLensShare.appex\"",
            "cp -R \"${src}\" \"${dst}/\"",
            "# Simulator builds are unsigned. A device build signs the copy with the",
            "# entitlements Xcode already processed for the extension target.",
            "if [ \"${CODE_SIGNING_REQUIRED}\" = \"YES\" ] && [ -n \"${EXPANDED_CODE_SIGN_IDENTITY}\" ] && [ \"${EXPANDED_CODE_SIGN_IDENTITY}\" != \"-\" ]; then",
            "  xcent=\"${CONFIGURATION_TEMP_DIR}/LetterLensShare.build/LetterLensShare.app-extension.xcent\"",
            "  if [ -f \"${xcent}\" ]; then",
            "    codesign --force --sign \"${EXPANDED_CODE_SIGN_IDENTITY}\" --entitlements \"${xcent}\" \"${dst}/LetterLensShare.appex\"",
            "  else",
            "    codesign --force --sign \"${EXPANDED_CODE_SIGN_IDENTITY}\" \"${dst}/LetterLensShare.appex\"",
            "  fi",
            "fi",
          ],
        },
      ],
      "package-product-members": [
        {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAILogic",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAppCheck",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseRemoteConfig",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "LetterLens-iOS/LetterLens-iOS.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "TU566926VK",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "LetterLens-iOS/Info.plist",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UIUserInterfaceStyle": "Light",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.tade.LetterLens-iOS",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "LetterLens-iOSTests",
      "id": "C4E8B1A07D2F49A6B3C5D7E2",
      "product": "Products/LetterLens-iOSTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "LetterLens-iOS",
      "dependencies": [
        "LetterLens-iOS",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "TU566926VK",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.tade.LetterLens-iOSTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/LetterLens-iOS.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/LetterLens-iOS",
      },
    }, {
      "name": "LetterLensShare",
      "id": "D1A2B3C4E5F60718293A4B5D",
      "product": "Products/LetterLensShare.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "LetterLensShare/LetterLensShare.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "TU566926VK",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "LetterLensShare/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "LetterLens",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.tade.LetterLens-iOS.Share",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "TU566926VK",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
