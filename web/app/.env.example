# Copy to .env.local and fill these in from the Firebase console.
# .env.local is gitignored. Never commit API keys, App Check debug tokens,
# or a downloaded GoogleService-Info.plist.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Local development only. Leave this empty for any shared or production build.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
